# Port the gateway listens on
PORT=3000

# Shared API key clients must send as `Authorization: Bearer <key>`
GATEWAY_API_KEY=change-me

# --- Providers (leave blank to skip that provider) ---
# Free tier: https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Local + free, requires `ollama serve` running: https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Order the router tries providers in, comma-separated
PROVIDER_ORDER=groq,gemini,ollama

# --- Cache (optional) ---
# Free Redis: https://upstash.com — leave blank to use an in-memory cache instead
REDIS_URL=
CACHE_TTL_SECONDS=3600

# --- Rate limiting ---
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_SECONDS=60

# --- Storage ---
LOG_PATH=./gateway-requests.jsonl
